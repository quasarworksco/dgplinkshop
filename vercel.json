{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.dgpgroupusa.com" }],
      "destination": "/public/index.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "app.dgpgroupusa.com" }],
      "destination": "/public/index.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "([a-z0-9-]+)\\.dgpgroupusa\\.com" }],
      "destination": "/public/tienda.html"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    }
  ]
}
